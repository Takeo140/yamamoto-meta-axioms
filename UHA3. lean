import Mathlib.Data.ZMod.Basic
import Mathlib.Data.Fin.Basic
import Mathlib.Algebra.Module.Basic
import Mathlib.Data.Fintype.Basic
import Mathlib.Algebra.BigOperators.Basic
import Mathlib.LinearAlgebra.Basic

open scoped BigOperators

/-- UltraCore の基本スカラー：U64 有限環 -/
abbrev U64 := ZMod (2^64)

/-- UltraCore HyperAlgebra の n 次元キャリア -/
structure UHA (n : Nat) where
  coords : Fin n → U64

namespace UHA

variable {n : Nat}

/-- 加算（branchless） -/
def add (x y : UHA n) : UHA n :=
  ⟨fun i => x.coords i + y.coords i⟩

instance : Add (UHA n) := ⟨add⟩

/-- スカラー倍 -/
def smul (a : U64) (x : UHA n) : UHA n :=
  ⟨fun i => a * x.coords i⟩

instance : SMul U64 (UHA n) := ⟨smul⟩

/-- 離散線形空間としてのインスタンス -/
instance : AddCommGroup (UHA n) where
  add := add
  add_assoc x y z := by
    cases x; cases y; cases z
    ext i; simp [add, add_assoc]
  zero := ⟨fun _ => 0⟩
  zero_add x := by
    cases x; ext i; simp [add]
  add_zero x := by
    cases x; ext i; simp [add]
  add_comm x y := by
    cases x; cases y; ext i; simp [add, add_comm]
  neg x := ⟨fun i => - x.coords i⟩
  add_left_neg x := by
    cases x; ext i; simp [add]

instance : Module U64 (UHA n) where
  smul := smul
  one_smul x := by
    cases x; ext i; simp [smul]
  mul_smul a b x := by
    cases x; ext i; simp [smul, mul_assoc]
  smul_add a x y := by
    cases x; cases y; ext i; simp [smul, add, mul_add]
  add_smul a b x := by
    cases x; ext i; simp [smul, add, add_mul]
  zero_smul x := by
    cases x; ext i; simp [smul]
  smul_zero a := by
    ext i; simp [smul]

/-- 多元代数の乗法（構造定数を外部から与える） -/
def mulWith
  (c : Fin n → Fin n → UHA n)
  (x y : UHA n) : UHA n :=
  ⟨fun i =>
    ∑ j, ∑ k, (x.coords j) * (y.coords k) * (c j k).coords i
  ⟩

/-- ノルム（量子状態の離散版） -/
def norm (x : UHA n) : U64 :=
  ∑ i, (x.coords i) * (x.coords i)

/-- 基底ベクトル（標準基底） -/
def basisVec (n : Nat) (i : Fin n) : UHA n :=
  ⟨fun j => if h : j = i then 1 else 0⟩

/-- ユニタリ様作用素（線形＋ノルム保存） -/
structure UOp (n : Nat) where
  f : UHA n → UHA n
  linear : ∀ x y a b,
    f (a • x + b • y) = a • f x + b • f y
  unitary_like : ∀ v, norm (f v) = norm v

namespace UOp

variable {n}

/-- 合成（ユニタリ様作用素の合成もユニタリ様） -/
def comp (U V : UOp n) : UOp n :=
  { f := fun x => U.f (V.f x)
    linear := by
      intro x y a b
      simp [U.linear, V.linear]
    unitary_like := by
      intro v
      simp [U.unitary_like, V.unitary_like] }

end UOp

end UHA
